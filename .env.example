# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API).
#
# Use SOMENTE a chave pública (anon / publishable). Ela pode ficar no front-end
# porque o acesso aos dados é protegido pelas políticas RLS do banco.
# NUNCA coloque a chave service_role / secret aqui.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Opcional: intervalo (ms) da consulta periódica usada quando o Realtime
# não está disponível. Padrão: 15000.
# VITE_SYNC_POLL_MS=15000

# Opcional — notificações no celular (ver docs/NOTIFICACOES.md).
# Chave PÚBLICA gerada com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# As demais (VAPID_PRIVATE_KEY, VAPID_SUBJECT, PUSH_WEBHOOK_SECRET,
# SUPABASE_SERVICE_ROLE_KEY) são só do servidor: cadastre na Vercel, nunca
# com o prefixo VITE_.
